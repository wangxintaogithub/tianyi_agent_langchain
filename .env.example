# ⚠️ 这是 Docker Compose 用的环境变量模板
# Python 后端运行时请配置 backend/.env
#
# 使用方式（生产部署）：
#   set DEEPSEEK_API_KEY=xxx
#   set TENCENT_COS_SECRET_ID=xxx
#   docker compose up -d --build

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 腾讯云 COS（文件上传服务）
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=

# 企业微信机器人 Webhook
WECHAT_WEBHOOK_URL=
